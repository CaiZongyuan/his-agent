# https://mineru.net/apiManage/docs
# Create a token at https://mineru.net/apiManage/docs
MINERU_KEY=

# Optional MinerU settings
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_MAX_POLL_ATTEMPTS=120

# https://sciverse.opendatalab.com/docs/sciverse/skills/paper-schema
SCIVERSE_API_TOKEN=

# ── ppt-master（references/ppt-master，skill 链接在 .claude/skills/ppt-master）──
# 图片生成后端（可选；不配置则用 Openverse/Wikimedia 零配置搜图）
# IMAGE_BACKEND=zhipu
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-image
# 网络搜图增强（可选，免费 key）：https://www.pexels.com/api/  https://pixabay.com/api/docs/
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
